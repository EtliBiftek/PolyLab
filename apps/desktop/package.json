{
  "name": "@polylab/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "PolyLab desktop shell — Electron main process, preload bridge and sidecar supervisor",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "electron": "30.5.1",
    "typescript": "5.6.3"
  }
}
